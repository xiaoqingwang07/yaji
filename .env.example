NODE_ENV=development
DATABASE_URL=postgresql://yaji:yaji@localhost:5432/yaji?schema=public
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
MOBILE_ENCRYPTION_KEY=dev-mobile-encryption-key-change-me
MOBILE_HASH_PEPPER=yaji-dev-pepper
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=yaji
STORAGE_ACCESS_KEY=yaji
STORAGE_SECRET_KEY=yaji-secret
STORAGE_FORCE_PATH_STYLE=true

# Provider：无密钥时全部使用 mock，项目须完整可演示
OCR_PROVIDER=mock
OCR_CONFIDENCE_THRESHOLD=0.85
LLM_PROVIDER=mock
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=
ASR_PROVIDER=mock
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
SMS_PROVIDER=mock
DEV_SMS_CODE=123456

APP_TIMEZONE=Asia/Shanghai
API_PORT=3001

# 移动端系统日历（expo-calendar）：无第三方密钥。
# Web 预览无法写入系统日历，会诚实降级为仅保存在芽纪内。
# 真机需用户授权日历权限（见 apps/mobile/app.json 的 expo-calendar 插件文案）。
# EXPO_PUBLIC_CALENDAR_SYNC=1
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
